# Local development can use http://127.0.0.1:8000.
# Vercel production must use the deployed Render backend origin, without a trailing slash.
VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_public_supabase_anon_key
# Supabase Storage uploads/downloads use the backend API; never add service-role keys here.
