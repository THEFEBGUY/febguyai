# FebGuy AI backend environment template
# Copy values into Render environment variables or a local backend/.env file.
# Never expose SUPABASE_SERVICE_ROLE_KEY or provider API keys in frontend/Vercel env.

# Runtime
APP_ENV=production
FEBGUY_ENV=production
API_PUBLIC_BASE_URL=https://your-render-service.onrender.com
CORS_ORIGINS=https://your-vercel-app.vercel.app,https://your-custom-domain.com
LOG_LEVEL=INFO
SLOW_ENDPOINT_LOG_MS=2000

# Database
# Local development: DATABASE_PROVIDER=sqlite
# Production Supabase Postgres: DATABASE_PROVIDER=postgres
DATABASE_PROVIDER=postgres
# FEBGUY_DATABASE_PROVIDER is still supported as a backward-compatible alias.
# FEBGUY_DATABASE_PROVIDER=postgres
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
POSTGRES_CONNECT_TIMEOUT=5
# Supabase transaction pooler compatibility/performance.
POSTGRES_STATEMENT_TIMEOUT_MS=5000
POSTGRES_LOCK_TIMEOUT_MS=3000
POSTGRES_POOL_MAX_SIZE=8
POSTGRES_POOL_TIMEOUT=5
DATABASE_HEALTH_CACHE_SECONDS=15

# Runtime file path for temporary processing caches and backward-compatible local files.
FEBGUY_DATA_DIR=/var/data/febguy

# Supabase Auth
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-backend-only-service-role-key

# Supabase Storage
# Bucket should allow PDF/DOCX/TXT/JPEG/PNG uploads for document storage.
# Profile avatar endpoints still validate and accept images only.
SUPABASE_STORAGE_BUCKET=profile-assets

# AI providers
GROQ_API_KEY=your-groq-api-key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GEMINI_API_KEY=your-gemini-api-key

# Model configuration
CHAT_MODEL=llama-3.1-8b-instant
CODE_MODEL=qwen/qwen3-32b
VISION_MODEL=gemini-2.0-flash
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
FAST_MODEL=llama-3.1-8b-instant
SMART_MODEL=llama-3.1-8b-instant
DEEP_MODEL=llama-3.1-8b-instant
RESPONSE_REFINER_MODEL=llama-3.1-8b-instant
ENABLE_RESPONSE_REFINER=false

# Voice/STT/TTS
STT_PROVIDER=groq
STT_MODEL=whisper-large-v3-turbo
VOICE_CHAT_MODEL=llama-3.1-8b-instant
TTS_PROVIDER=browser

# Optional integrations
RESEND_API_KEY=
EMAIL_FROM=
WEATHER_API_KEY=
ILOVEPDF_PUBLIC_KEY=
ILOVEPDF_SECRET_KEY=
TESSERACT_CMD=

# Limits and safety
FEBGUY_MAX_UPLOAD_MB=10
FEBGUY_MAX_PROFILE_IMAGE_MB=4
FEBGUY_MAX_REQUEST_MB=20
FEBGUY_MAX_MESSAGE_CHARS=24000
FEBGUY_MAX_CHATS=30
FEBGUY_CONTEXT_LIMIT=12000
FEBGUY_RATE_LOGIN_REQUESTS=10
FEBGUY_RATE_PIN_REQUESTS=8
FEBGUY_RATE_PIN_RESET_REQUESTS=12
FEBGUY_RATE_GUEST_CHAT_REQUESTS=20
FEBGUY_RATE_UPLOAD_REQUESTS=15
FEBGUY_RATE_AI_REQUESTS=45
